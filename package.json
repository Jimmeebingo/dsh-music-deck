{
  "name": "dsh-music-deck",
  "version": "1.0.1",
  "description": "Floating music controls for players that publish Windows system media sessions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jimmeebingo/dsh-music-deck.git"
  },
  "homepage": "https://github.com/Jimmeebingo/dsh-music-deck#readme",
  "bugs": {
    "url": "https://github.com/Jimmeebingo/dsh-music-deck/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "music",
    "now-playing",
    "smtc",
    "windows"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "agent/smtc.ps1",
    "agent/Cover.cs",
    "agent/Volume.cs",
    "agent/sessions.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
