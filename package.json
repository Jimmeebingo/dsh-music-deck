{
  "name": "dsh-music-deck",
  "version": "1.0.0",
  "description": "Floating player that reads and controls the system media session of QQ Music, NetEase Cloud Music and Spotify.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "music",
    "now-playing",
    "smtc",
    "windows"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "agent/smtc.ps1",
    "agent/Cover.cs",
    "agent/Volume.cs",
    "agent/sessions.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}